@page
@model ThuyetMinh.Api.Pages.Admin.ReviewListModel
@{
    ViewData["Title"] = "Duyệt bài";
}

<h2>Bài gửi chờ duyệt</h2>

@if (!Model.Submissions.Any())
{
    <p>Không có bài nào đang chờ duyệt.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Quán</th>
                <th>Tên đề nghị</th>
                <th>Ngày gửi</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Submissions)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Shop?.Name</td>
                <td>@s.Name</td>
                <td>@s.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a class="btn btn-primary" href="/Admin/ReviewDetail?id=@s.Id">Xem xét</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}