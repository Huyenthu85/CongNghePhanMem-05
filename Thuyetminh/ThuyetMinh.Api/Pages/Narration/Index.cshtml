@page
@model ThuyetMinh.Api.Pages.Narration.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Nghe thuyết minh";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nghe thuyết minh - Thuyết Minh Du Lịch</title>
    <link rel="stylesheet" href="~/css/narration.css" asp-append-version="true" />
</head>
<body>
<div class="tour-page">

    <header class="tour-header">
        <a class="tour-logo" href="/Narration">
            <span class="logo-icon">♫</span>
            <span>Thuyết Minh Du Lịch</span>
        </a>

        <nav class="tour-nav">
            <a href="#intro">Giới thiệu</a>
            <a href="#explore">Khám phá</a>
            <a href="#audio">Thuyết minh</a>
        </nav>

        <span class="gps-status">
            <span class="gps-dot"></span>
            GPS chưa kết nối
        </span>
    </header>

    <main class="narration-main">

        <section class="map-section" id="intro">
            <div class="map-topbar">
                <div>
                    <span class="section-label">KHÁM PHÁ XUNG QUANH</span>
                    <h1>Bản đồ địa điểm</h1>
                    <p>Xem vị trí và khám phá khu vực tham quan.</p>
                </div>
                <span class="map-status">
                    <span class="gps-dot"></span>
                    Bản đồ minh họa
                </span>
            </div>

            <div class="map-frame">
                <iframe
                    title="Bản đồ địa điểm tham quan"
                    src="https://www.openstreetmap.org/export/embed.html?bbox=106.65%2C10.75%2C106.73%2C10.81&amp;layer=mapnik&amp;marker=10.7769%2C106.7009"
                    loading="lazy">
                </iframe>
            </div>

            <p class="map-note">
                Vị trí đang hiển thị là vị trí minh họa tại TP. Hồ Chí Minh.
            </p>
        </section>

        <section class="place-layout" id="explore">

            <div class="place-photo">
                <img
                    src="https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&amp;fit=crop&amp;w=800&amp;q=85"
                    alt="Không gian quán cà phê" />

                <div class="photo-caption">
                    <span>ĐIỂM ĐẾN CỦA BẠN</span>
                    <h2>Quán cà phê mẫu</h2>
                </div>
            </div>

            <section class="tour-details">
                <span class="section-label">ĐỊA ĐIỂM THAM QUAN</span>

                <h2>Quán cà phê mẫu</h2>

                <p class="tour-location">
                    <span>⌖</span> Địa chỉ sẽ được cập nhật
                </p>

                <div class="language-box">
                    <label for="language">Ngôn ngữ thuyết minh</label>
                    <select id="language" name="language">
                        <option value="vi">Tiếng Việt</option>
                        <option value="en">English</option>
                        <option value="zh">Tiếng Trung</option>
                        <option value="km">Tiếng Khmer</option>
                    </select>
                </div>

                <div class="tour-description">
                    <h3>Giới thiệu địa điểm</h3>
                    <p id="translation-text">
                        Chọn ngôn ngữ để xem nội dung thuyết minh.
                    </p>
                </div>

                <div class="gps-notice">
                    <span class="gps-notice-icon">⌖</span>
                    <div>
                        <strong>Trạng thái vị trí</strong>
                        <p>
                            GPS chưa kết nối. Vị trí thực tế sẽ được cập nhật
                            khi tích hợp chức năng định vị.
                        </p>
                    </div>
                </div>
            </section>

        </section>
    </main>

    <footer class="audio-dock" id="audio">
        <div class="dock-title">
            <strong>Quán cà phê mẫu</strong>
            <span>Thuyết minh du lịch</span>
        </div>

        <div class="audio-controls">
        <audio id="narration-audio" controls preload="none">
            Trình duyệt của bạn không hỗ trợ phát âm thanh.
        </audio>
            <span class="audio-status">Chưa kết nối file âm thanh</span>
        </div>

        <div class="dock-right">
            <div class="remaining-time">
                <span class="clock-icon">◷</span>
                <div>
                    <small>THỜI GIAN CÒN LẠI</small>
                    <strong id="remaining-time">Chờ API</strong>
                </div>
            </div>

            <a class="payment-link" href="#" id="payment-link">
                Thanh toán QR
            </a>
        </div>
    </footer>


</div>

<script>
document.addEventListener("DOMContentLoaded", async function () {
    const languageSelect = document.getElementById("language");
    const translationText = document.getElementById("translation-text");
    const audioPlayer = document.getElementById("narration-audio");
    const audioStatus = document.querySelector(".audio-status");
    const remainingTime = document.getElementById("remaining-time");

    let languages = [];

    async function loadNarration() {
        audioPlayer.pause();
        audioPlayer.removeAttribute("src");
        audioPlayer.load();

        translationText.textContent = "Đang tải bản dịch...";
        audioStatus.textContent = "Đang tải âm thanh...";
        if (remainingTime) remainingTime.textContent = "Chưa có dữ liệu";

        const params = new URLSearchParams(window.location.search);
        const submissionId = Number(params.get("shopSubmissionId"));

        if (!submissionId) {
            translationText.textContent =
                "Chưa có hồ sơ địa điểm để tải bản dịch.";
            audioStatus.textContent = "Chưa có dữ liệu âm thanh";
            return;
        }

        const language = languages.find(
            item => item.code === languageSelect.value
        );

        if (!language) {
            translationText.textContent = "Vui lòng chọn ngôn ngữ.";
            audioStatus.textContent = "Chưa chọn ngôn ngữ";
            return;
        }

        try {
            const url =
                `/api/Translation/search?shopSubmissionId=${submissionId}` +
                `&languageId=${language.id}`;

            const response = await fetch(url);

            if (response.status === 404) {
                translationText.textContent =
                    "Chưa có bản dịch cho ngôn ngữ này.";
                audioStatus.textContent = "Chưa có bản dịch";
                return;
            }

            if (!response.ok) {
                throw new Error("Không tải được bản dịch.");
            }

            const translation = await response.json();

            translationText.textContent =
                translation.translatedText || "Bản dịch chưa có nội dung.";

            const audioResponse = await fetch(
                `/api/Audio/translation/${translation.id}`
            );

            if (audioResponse.status === 404) {
                audioStatus.textContent = "Chưa có file âm thanh";
                return;
            }

            if (!audioResponse.ok) {
                throw new Error("Không tải được thông tin audio.");
            }

            const audio = await audioResponse.json();

            if (!audio.filePath) {
                audioStatus.textContent = "Chưa có file âm thanh";
                return;
            }

            let audioUrl = audio.filePath;

            if (!/^https?:\/\//i.test(audioUrl) &&
                !audioUrl.startsWith("/")) {
                audioUrl = "/" + audioUrl;
            }

            audioPlayer.src = audioUrl;
            audioPlayer.load();

            audioStatus.textContent = "Đã tải thông tin audio";

            if (remainingTime) {
                remainingTime.textContent =
                    `${audio.durationSeconds || 0} giây`;
            }
        } catch (error) {
            console.error(error);
            translationText.textContent =
                "Không thể tải dữ liệu thuyết minh.";
            audioStatus.textContent = "Lỗi kết nối API";
        }
    }

    try {
        const response = await fetch("/api/Language");

        if (!response.ok) {
            throw new Error("Không tải được danh sách ngôn ngữ.");
        }

        const data = await response.json();
        languages = data.filter(item => item.isActive);

        languageSelect.innerHTML = "";

        languages.forEach(language => {
            const option = document.createElement("option");
            option.value = language.code;
            option.textContent = language.name;
            languageSelect.appendChild(option);
        });

        if (languages.length === 0) {
            languageSelect.innerHTML =
                '<option value="">Chưa có ngôn ngữ</option>';
            translationText.textContent = "Chưa có ngôn ngữ khả dụng.";
            return;
        }

        languageSelect.value = languages.some(item => item.code === "vi")
            ? "vi"
            : languages[0].code;

        languageSelect.addEventListener("change", loadNarration);

        await loadNarration();
    } catch (error) {
        console.error(error);
        languageSelect.innerHTML =
            '<option value="">Không tải được ngôn ngữ</option>';
        translationText.textContent = "Không kết nối được API ngôn ngữ.";
        audioStatus.textContent = "Lỗi kết nối API";
    }
});

</script>

</body>
</html>
