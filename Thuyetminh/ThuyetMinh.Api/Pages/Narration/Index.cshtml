@page
@model ThuyetMinh.Api.Pages.Narration.IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Thuyết minh đa ngôn ngữ";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thuyết minh đa ngôn ngữ</title>
    <link rel="stylesheet" href="~/css/narration.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/visitor-language.css" asp-append-version="true" />
</head>
<body data-shop-id="0" data-require-gps="@(Model.RequireGps ? "true" : "false")">
@Html.AntiForgeryToken()
<div class="tour-page">
    <header class="tour-header">
        <div class="header-inner">
            <a class="tour-logo" href="/Narration"><span class="logo-icon">♫</span><span>Thuyết Minh Tự Động Đa Ngôn Ngữ<small>KHÁM PHÁ QUA ÂM THANH</small></span></a>
            <nav class="tour-nav" aria-label="Điều hướng chính"><a href="/Narration" class="nav-current">Khám phá</a><a href="/Narration#destinations">Địa điểm</a></nav>
            <div class="header-balance">
                <small id="header-balance-label">THỜI GIAN CÒN LẠI</small>
                <strong id="header-remaining-time">@(Model.RemainingSeconds / 60):@((Model.RemainingSeconds % 60).ToString("D2"))</strong>
            </div>

        </div>
    </header>
    <main class="narration-main">
        <section id="listing-view" class="browse-view">
            <div class="browse-hero">
                <div class="hero-content">
                    <span class="eyebrow"><span class="eyebrow-line"></span> KHÁM PHÁ SÀI GÒN THEO CÁCH RIÊNG</span>
                    <h1>Mỗi địa điểm.<br><em>Một câu chuyện.</em></h1>
                    <p>Lắng nghe những câu chuyện thú vị đằng sau mỗi điểm đến. Khám phá ẩm thực và văn hóa địa phương bằng ngôn ngữ bạn yêu thích.</p>
                    <a class="primary-action" href="#destinations">Khám phá địa điểm <span aria-hidden="true">↗</span></a>
                    <div class="hero-facts"><span><strong>05</strong> Địa điểm giới thiệu</span><span class="fact-separator"></span><span><strong>04</strong> Ngôn ngữ dự kiến</span></div>
                </div>
                <div class="hero-photo"><img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1300&q=85" alt="Không gian ẩm thực" /><div class="hero-photo-caption"><span class="caption-mark">✦</span><span>TRẢI NGHIỆM ĐỊA PHƯƠNG<small>KHÁM PHÁ • LẮNG NGHE • CẢM NHẬN</small></span></div></div>
            </div>
            <section class="destination-section" id="destinations" aria-label="Danh sách địa điểm">
                <div class="section-heading"><div><span class="eyebrow">ĐỊA ĐIỂM ĐỀ XUẤT</span><h2>Điểm đến đang chờ bạn</h2><p>Chọn một địa điểm để tìm hiểu và nghe thuyết minh.</p></div><label class="search-box"><span aria-hidden="true">⌕</span><input id="shop-search" type="search" placeholder="Tìm theo tên địa điểm..." aria-label="Tìm kiếm địa điểm" /></label></div>
                <div id="shop-grid" class="shop-grid"></div>
                <p id="search-empty" class="search-empty" hidden>Không tìm thấy địa điểm phù hợp.</p>
            </section>
        </section>
        <section id="detail-view" class="detail-view" hidden>
            <div class="detail-topbar"><a href="/Narration" class="back-link" id="back-to-list">← Tất cả địa điểm</a><span class="detail-breadcrumb">KHÁM PHÁ <span>/</span> CHI TIẾT ĐỊA ĐIỂM</span></div>
            <div class="detail-heading">
                <span class="eyebrow">HÀNH TRÌNH ẨM THỰC</span>
                <h1 id="shop-name"></h1>
                <p id="shop-address" class="detail-address"></p>
                <p id="hero-description" class="hero-description"></p>
                <div class="detail-tags" aria-label="Đặc điểm trải nghiệm">
                    <span>🍽 Ẩm thực Việt Nam</span>
                    <span>◎ Thuyết minh đa ngôn ngữ</span>
                    <span>⌖ Khám phá địa điểm</span>
                </div>
            </div>
            <div class="detail-layout">
                <div class="detail-photo-wrap">
                    <img id="detail-photo" alt="Hình minh họa địa điểm" />
                    <button type="button" class="gallery-arrow gallery-prev" id="gallery-prev" aria-label="Ảnh trước">‹</button>
                    <button type="button" class="gallery-arrow gallery-next" id="gallery-next" aria-label="Ảnh sau">›</button>
                    <div class="gallery-bottom">
                        <span class="image-label">HÌNH ẢNH MINH HỌA</span>
                        <div class="gallery-thumbnails" id="gallery-thumbnails" aria-label="Chọn ảnh"></div>
                        <span class="gallery-count" id="gallery-count">1 / 1</span>
                    </div>
                </div>
                <div class="detail-info">
                    <div class="info-header"><span class="info-number">01 / KHÁM PHÁ</span><span class="info-symbol" aria-hidden="true">✦</span></div>
                    <h2>Câu chuyện địa điểm</h2>
                    <div class="tour-description"><p id="shop-description" class="short-description"></p></div>
                    <p class="story-quote" id="story-quote">Mỗi điểm đến là một câu chuyện về văn hóa và ẩm thực địa phương.</p>
                    <div class="info-divider"></div>
                    <div class="language-box"><label for="language">CHỌN NGÔN NGỮ THUYẾT MINH</label><select id="language" disabled><option>Đang tải...</option></select><p class="language-note">Nội dung và âm thanh phụ thuộc dữ liệu đã được duyệt.</p></div>
                    <div class="narration-text-card">
                        <div class="narration-card-head"><strong>▤ Nội dung thuyết minh</strong><span id="translation-label">Theo ngôn ngữ đã chọn</span></div>
                        <p id="narration-text-status">Nội dung thuyết minh sẽ được hiển thị khi có bản dịch đã duyệt.</p>
                    </div>
                    <p id="api-status" class="api-status" role="status"></p>
                </div>
            </div>
            <div class="detail-bottom">
                <section class="map-section" id="about">
                    <div class="map-header">
                        <div class="map-copy"><span class="eyebrow">02 / VỊ TRÍ</span><h2>⌖ Vị trí trên bản đồ</h2><p id="map-note" class="muted"></p></div>
                        <div class="map-actions"><span id="gps-result" class="gps-result" role="status">Chưa xác định vị trí</span><button type="button" id="enable-location" class="location-button">⌖ Bật định vị</button></div>
                    </div>
                    <div class="map-frame"><iframe id="shop-map" title="Bản đồ vị trí quán" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
                    <p class="map-disclaimer">Vị trí chỉ mang tính tham khảo; quyền phát thuyết minh vẫn do máy chủ kiểm tra.</p>
                </section>
            </div>
        </section>
    </main>
    <footer id="audio-dock" class="audio-dock" hidden>
        <div class="audio-dock-inner">
            <div class="dock-title">
                <span class="dock-kicker">ĐANG KHÁM PHÁ</span>
                <strong id="dock-shop-name"></strong>
                <span>Trình phát thuyết minh</span>
            </div>
            <div class="audio-controls">
                <button type="button" id="narration-start-audio" class="location-button" hidden>Phát thuyết minh</button>
                <audio id="narration-audio" controls preload="none">
                    Trình duyệt không hỗ trợ audio.
                </audio>
                <span id="audio-status" class="audio-status">Chưa có audio</span>
            </div>
            <div class="dock-right">
                <div class="remaining-time">
                    <small>THỜI GIAN CÒN LẠI</small>
                    <strong id="remaining-time">@(Model.RemainingSeconds / 60):@((Model.RemainingSeconds % 60).ToString("D2"))</strong>
                </div>
            </div>
        </div>
    </footer>
</div>
<script src="~/js/visitor-language.js" asp-append-version="true"></script>
<script src="~/js/narration-language.js" asp-append-version="true"></script>
<script src="~/js/narration-listening.js" asp-append-version="true" defer></script>
<script>
(() => {
    const approvedShops = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApprovedShops, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
    const shops = approvedShops.map(item => ({
            slug: `approved-${item.id}`,
            shopId: item.id,
            name: item.name,
            address: item.address,
            lat: item.latitude,
            lon: item.longitude,
            desc: item.descriptions?.vi || 'Địa điểm đã được duyệt trong hệ thống.',
            publishedDescriptions: item.descriptions || {},
            image: item.images?.[0] || '/images/place-placeholder.svg',
            images: item.images?.length ? item.images : ['/images/place-placeholder.svg']
    }));

    const factCount = document.querySelector('.hero-facts strong');
    if (factCount) {
        factCount.textContent = String(shops.length).padStart(2, '0');
    }

    const $ = id => document.getElementById(id);
    const say = (id, key, fallback, ...args) => {
        if (window.TMNarration) window.TMNarration.say($(id), key, ...args);
        else $(id).textContent = fallback;
    };
    const raw = (id, text) => {
        if (window.TMNarration) window.TMNarration.raw($(id), text);
        else $(id).textContent = text;
    };
    const escapeHtml = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const params = new URLSearchParams(location.search);
    // Also track paid visitors while browsing without playing audio.
    if (@Model.RemainingSeconds > 0) {
        setInterval(() => {
            if (!document.hidden)
                fetch('/api/visitor/me', {credentials:'same-origin', cache:'no-store'}).catch(() => {});
        }, 15000);
    }
    const legacyPlace = {'gia-dinh-pho':'approved-1','bun-cha-36-pho':'approved-2',
        'pho-sai-gon-xua':'approved-3','oc-dem-sai-thanh':'approved-4','com-tam-ba-ghien':'approved-5'};
    const selected = shops.find(x => x.slug === (legacyPlace[params.get('place')] || params.get('place')));
    document.querySelectorAll('a[href^="/Narration"]').forEach(a => {
        const url = new URL(a.getAttribute('href'), location.origin);
        if (params.get('preview') === '1') url.searchParams.set('preview', '1');
        a.setAttribute('href', url.pathname + url.search + url.hash);

        if (selected && !url.searchParams.has('place')) {
            a.addEventListener('click', () => {
                try {
                    sessionStorage.setItem(
                        'tm_auto_gps_back_until_v2',
                        String(Date.now() + 15000)
                    );
                } catch {}
            });
        }
    });
    const audio = $('narration-audio');
    let versionId = null, languages = [], requestSeq = 0;
    const setStatus = (key, message) => say('api-status', key, message);
    const stopAudio = () => {
        delete audio.dataset.audioId;
        document.dispatchEvent(new Event('tm:audio-changing'));
        audio.pause();
        audio.removeAttribute('src');
        audio.load();
    };


    if (!selected) {
        // AUTO GPS: find the nearest approved shop inside its activation radius.
        if (navigator.geolocation && params.get('preview') !== '1') {
            let navigating = false;

            const distanceMeters = (lat1, lon1, lat2, lon2) => {
                const rad = n => n * Math.PI / 180;
                const dLat = rad(lat2 - lat1);
                const dLon = rad(lon2 - lon1);

                const h = Math.sin(dLat / 2) ** 2 +
                    Math.cos(rad(lat1)) * Math.cos(rad(lat2)) *
                    Math.sin(dLon / 2) ** 2;

                return 6371000 * 2 * Math.asin(Math.min(1, Math.sqrt(h)));
            };

            let latestFix = null, watcher = null;
            const checkPosition = pos => {
                if (navigating || (window.TMUI && !window.TMUI.hasChosen())) return;
                if (Date.now() - pos.timestamp > 30000 || pos.timestamp > Date.now() + 10000) return;

                const {latitude, longitude, accuracy} = pos.coords;

                if (![latitude, longitude, accuracy].every(Number.isFinite) || accuracy <= 0)
                    return;

                let closest = null;

                for (const site of approvedShops) {
                    const radius = Number(site.activationRadiusMeters);
                    const shop = shops.find(x =>
                        Number(x.shopId) === Number(site.id));

                    if (!shop || !Number.isFinite(radius) || radius <= 0)
                        continue;

                    const meters = distanceMeters(
                        latitude, longitude,
                        site.latitude, site.longitude
                    );

                    if (meters > radius ||
                        accuracy > Math.max(100, radius))
                        continue;

                    if (!closest || meters < closest.meters) {
                        closest = {shop, meters};
                    }
                }

                // GPS-AUTO-REENTRY-GUARD
                // Trigger automatically once per zone entry, not on every page visit.
                const latchKey = "tm_auto_gps_played_shop_v2";
                let lastShopId;

                try {
                    if (Number(sessionStorage.getItem('tm_auto_gps_back_until_v2')) > Date.now()) return;
                    lastShopId = sessionStorage.getItem(latchKey);
                } catch {
                    // If storage is unavailable, keep manual navigation.
                    return;
                }

                if (lastShopId) {
                    const lastSite = approvedShops.find(x =>
                        String(x.id) === lastShopId);

                    if (lastSite) {
                        const radius = Number(lastSite.activationRadiusMeters);
                        const distance = distanceMeters(
                            latitude, longitude,
                            lastSite.latitude, lastSite.longitude
                        );

                        // Use a margin to avoid GPS jitter near the boundary.
                        const exitThreshold = radius + Math.max(50, accuracy);

                        if (!Number.isFinite(radius) ||
                            !Number.isFinite(distance) ||
                            accuracy > Math.max(100, radius) ||
                            distance <= exitThreshold) {
                            return;
                        }
                    }

                    try {
                        sessionStorage.removeItem(latchKey);
                    } catch {
                        return;
                    }
                }

                if (closest) {
                    navigating = true;
                    if (watcher !== null) navigator.geolocation.clearWatch(watcher);

                    window.location.replace(
                        '/Narration?place=' +
                        encodeURIComponent(closest.shop.slug)
                    );
                }
            };

            const acceptPosition = pos => {
                if (navigating || !Number.isFinite(pos.timestamp)) return;

                if (latestFix && (pos.timestamp < latestFix.timestamp ||
                    (pos.timestamp === latestFix.timestamp &&
                     pos.coords.accuracy >= latestFix.coords.accuracy))) return;

                latestFix = pos;
                checkPosition(pos);
            };

            document.addEventListener('tm:ui-language-changed', () => {
                if (latestFix && Date.now() - latestFix.timestamp <= 5000)
                    checkPosition(latestFix);
                else if (!navigating)
                    navigator.geolocation.getCurrentPosition(
                        acceptPosition, () => {}, {
                            enableHighAccuracy: false,
                            maximumAge: 5000,
                            timeout: 4000
                        }
                    );
            });

            navigator.geolocation.getCurrentPosition(
                acceptPosition, () => {}, {
                    enableHighAccuracy: false,
                    maximumAge: 5000,
                    timeout: 4000
                });

            watcher = navigator.geolocation.watchPosition(acceptPosition, () => {}, {
                enableHighAccuracy: true,
                maximumAge: 0,
                timeout: 20000
            });

            window.addEventListener('pagehide', () => {
                navigator.geolocation.clearWatch(watcher);
            }, {once: true});
        }

        $('listing-view').hidden = false;
        $('detail-view').hidden = true;
        $('shop-grid').innerHTML = shops.map(s => `
            <a class="shop-card" href="/Narration?place=${encodeURIComponent(s.slug)}${params.get('preview') === '1' ? '&preview=1' : ''}">
                <div class="shop-card-image"><img src="${escapeHtml(s.image)}" alt="Ảnh minh họa ${escapeHtml(s.name)}" loading="lazy"></div>
                <div class="shop-card-body"><span class="section-label">QUÁN ĂN • TP.HCM</span><h2>${escapeHtml(s.name)}</h2><p class="shop-address" data-original-address="${escapeHtml(s.address)}">${escapeHtml(s.address)}</p><p data-original-description="${escapeHtml(s.desc)}">${escapeHtml(s.desc)}</p><span class="card-arrow">Xem chi tiết →</span></div>
            </a>`).join('');
        window.TMNarration?.localizeCards();
        $('search-empty').hidden = shops.length !== 0;

        $('shop-grid').querySelectorAll('.shop-card').forEach((card,i) => {
            const shop = shops[i];

            window.TMNarration?.setDescription(
                card.querySelector('[data-original-description]'),
                shop.desc,
                shop.publishedDescriptions
            );
        });
        const search = $('shop-search');
        document.addEventListener('tm:ui-language-changed', () => search.dispatchEvent(new Event('input')));
        search.addEventListener('input', () => {
            const query = search.value.trim().toLocaleLowerCase('vi');
            let visible = 0;
            $('shop-grid').querySelectorAll('.shop-card').forEach((card, index) => {
                const shop = shops[index];
                const addressText = card.querySelector('.shop-address')?.textContent || '';
                const descriptionText = card.querySelector('[data-original-description]')?.textContent || '';
                const match = (shop.name + ' ' + shop.address + ' ' + addressText + ' ' + shop.desc + ' ' + descriptionText).toLocaleLowerCase('vi').includes(query);
                card.hidden = !match;
                if (match) visible++;
            });
            $('search-empty').hidden = visible !== 0;
        });
        return;
    }


    $('listing-view').hidden = true;
    $('detail-view').hidden = false;
    $('audio-dock').hidden = false;
    $('shop-name').textContent = selected.name;
    $('dock-shop-name').textContent = selected.name;
    if (window.TMNarration) window.TMNarration.setAddress($('shop-address'), selected.address);
    else $('shop-address').textContent = selected.address;
    if (window.TMNarration?.setDescription) window.TMNarration.setDescription($('hero-description'), selected.desc, selected.publishedDescriptions);
    else $('hero-description').textContent = selected.desc;
    $('detail-view').style.setProperty('--shop-hero-image', `url("${selected.image}")`);
    if (window.TMNarration?.setDescription) window.TMNarration.setDescription($('shop-description'), selected.desc, selected.publishedDescriptions);
    else $('shop-description').textContent = selected.desc;
    $('detail-photo').src = selected.image;
    $('detail-photo').alt = 'Ảnh minh họa ' + selected.name;
    if (window.TMNarration) window.TMNarration.setAddress($('map-note'), selected.address);
    else $('map-note').textContent = selected.address;

    // Bộ ảnh minh họa; nếu chưa có ảnh bổ sung của quán thì chỉ hiển thị ảnh hiện có.
    const galleryImages = selected.images;
    let galleryIndex = 0;
    const renderGallery = () => {
        $('detail-photo').src = galleryImages[galleryIndex];
        $('gallery-count').textContent = `${galleryIndex + 1} / ${galleryImages.length}`;
        $('gallery-thumbnails').innerHTML = galleryImages.map((url, i) =>
            `<button type="button" class="gallery-thumb ${i === galleryIndex ? 'active' : ''}" data-index="${i}" aria-label="Xem ảnh ${i+1}"><img src="${escapeHtml(url)}" alt="Ảnh minh họa ${i+1}"></button>`
        ).join('');
        $('gallery-prev').hidden = galleryImages.length < 2;
        $('gallery-next').hidden = galleryImages.length < 2;
        $('gallery-thumbnails').hidden = galleryImages.length < 2;
    };
    $('gallery-prev').addEventListener('click', () => {galleryIndex = (galleryIndex - 1 + galleryImages.length) % galleryImages.length; renderGallery();});
    $('gallery-next').addEventListener('click', () => {galleryIndex = (galleryIndex + 1) % galleryImages.length; renderGallery();});
    $('gallery-thumbnails').addEventListener('click', e => {
        const button = e.target.closest('button[data-index]');
        if (button) { galleryIndex = Number(button.dataset.index); renderGallery(); }
    });
    renderGallery();

    // GPS chỉ hiển thị khoảng cách tham khảo, KHÔNG cấp quyền nghe.
    $('enable-location').addEventListener('click', () => {
        if (!navigator.geolocation) { say('gps-result','gpsUnsupported','Trình duyệt không hỗ trợ định vị'); return; }
        say('gps-result','gpsLooking','Đang xác định vị trí...');
        navigator.geolocation.getCurrentPosition(pos => {
            const rad = n => n * Math.PI / 180;
            const lat1 = pos.coords.latitude, lon1 = pos.coords.longitude;
            const dLat = rad(selected.lat - lat1), dLon = rad(selected.lon - lon1);
            const a = Math.sin(dLat / 2)**2 + Math.cos(rad(lat1)) * Math.cos(rad(selected.lat)) * Math.sin(dLon / 2)**2;
            const meters = 6371000 * 2 * Math.asin(Math.min(1, Math.sqrt(a)));
            const value = meters < 1000 ? Math.round(meters) : (meters / 1000).toFixed(1);
            const unit = meters < 1000 ? 'm' : 'km';
            say('gps-result','distance',`Cách khoảng ${value} ${unit}`,value,unit);
        }, err => {say('gps-result',err.code === 1 ? 'gpsDenied' : 'gpsFailed',err.code === 1 ? 'Bạn chưa cấp quyền định vị' : 'Không lấy được vị trí');},
        {enableHighAccuracy: true, timeout: 12000, maximumAge: 30000});
    });



    // Use real IDs from approved database rows, never assume that IDs start at 1.
    const approvedShop = approvedShops.find(x => Number(x.id) === Number(selected.shopId));
    document.body.dataset.shopId = approvedShop ? String(approvedShop.id) : '0';

    if (approvedShop) {
        document.body.dataset.shopLatitude = String(approvedShop.latitude);
        document.body.dataset.shopLongitude = String(approvedShop.longitude);
        document.body.dataset.shopRadius = String(approvedShop.activationRadiusMeters);
    }
    const delta = 0.006;
    const map = new URLSearchParams({bbox:[selected.lon-delta,selected.lat-delta,selected.lon+delta,selected.lat+delta].join(','),layer:'mapnik',marker:`${selected.lat},${selected.lon}`});
    $('shop-map').src = 'https://www.openstreetmap.org/export/embed.html?' + map.toString();


    audio.addEventListener('error', () => say('audio-status','audioError','Không tải được file âm thanh'));
    audio.addEventListener('ended', () => say('audio-status','finished','Đã phát xong'));


    async function loadNarration() {
        const requestId = ++requestSeq;
        stopAudio();
        say('narration-text-status','checkingTranslation','Đang kiểm tra bản dịch...');
        raw('translation-label', $('language').selectedOptions[0]?.textContent || '');
        const language = languages.find(l => l.code === $('language').value);
        if (!versionId || !language) return;
        say('audio-status','loadingAudio','Đang tải audio...');
        try {
            const r = await fetch(`/api/Translation/search?shopSubmissionId=${versionId}&languageId=${language.id}`);
            if (!r.ok) throw Object.assign(new Error(r.status === 404 ? 'Quán chưa có bản dịch cho ngôn ngữ này.' : 'Không tải được bản dịch.'), {uiKey: r.status === 404 ? 'noTranslation' : 'translationError'});
            const translation = await r.json();
            if (requestId !== requestSeq) return;
            setStatus('approved','Nội dung đã được duyệt.');
            if (translation.translatedText) raw('narration-text-status', translation.translatedText);
            else say('narration-text-status','emptyTranslation','Có bản dịch nhưng chưa có nội dung văn bản để hiển thị.');
            const a = await fetch(`/api/Audio/translation/${translation.id}`);
            if (requestId !== requestSeq) return;
            if (a.status === 404) { say('audio-status','noAudio','Chưa có audio'); return; }
            if (!a.ok) throw new Error('Không tải được thông tin audio.');
            const item = await a.json();
            if (requestId !== requestSeq) return;
            if (!item.id || item.status !== 'Success') throw new Error('Audio chưa sẵn sàng.');
            audio.dataset.audioId = String(item.id);
            say('audio-status','ready','Sẵn sàng phát');

            document.dispatchEvent(new CustomEvent('tm:audio-ready', {
                detail: {shopId: approvedShop.id, audioId: item.id}
            }));
        } catch(e) {
            if (requestId === requestSeq) { setStatus(e.uiKey || 'translationError',e.message); say('audio-status','noAudio','Chưa có audio'); say('narration-text-status',e.uiKey || 'translationError',e.message); }
        }
    }
    $('language').addEventListener('change', loadNarration);

    // TM-AUDIO-LANGUAGE-SYNC
    document.addEventListener('tm:ui-language-changed', () => {
        const preferred = window.TMUI?.language() || 'vi';
        const select = $('language');

        if (!languages.length) return;

        const target = languages.find(l => l.code === preferred);

        if (!target) {
            select.selectedIndex = -1;

            if (versionId) {
                ++requestSeq;
                stopAudio();
                setStatus('languageMissing', 'Ngôn ngữ này chưa khả dụng.');
                say('audio-status', 'noAudio', 'Chưa có audio');
                say('narration-text-status', 'noTranslation', 'Chưa có bản dịch');
            }

            return;
        }

        if (select.value === target.code) return;

        select.value = target.code;

        if (versionId) {
            void loadNarration();
        }
    });
    (async () => {
        try {
            if (window.TMUI) await window.TMUI.whenChosen();
            const r = await fetch('/api/Language');
            if (!r.ok) throw new Error('Không tải được danh sách ngôn ngữ.');
            const all = await r.json();
            languages = Array.isArray(all) ? all : all.value;
            if (!Array.isArray(languages)) throw new Error('Dữ liệu ngôn ngữ không hợp lệ.');
            languages = languages.filter(l =>
                l.isActive && ['vi', 'en', 'zh', 'km'].includes(l.code?.toLowerCase())
            );
            $('language').innerHTML = languages.map(l => `<option value="${escapeHtml(l.code)}">${escapeHtml(window.TMNarration?.languageName(l.code) || l.name)}</option>`).join('');
            $('language').disabled = languages.length === 0;
            const preferred = window.TMUI?.language() || 'vi';
            if (languages.some(l => l.code === preferred)) $('language').value = preferred;
            else $('language').selectedIndex = -1;


            if (!approvedShop) {
                setStatus('noApproved','Đây là địa điểm tham khảo, chưa có bản ghi đã duyệt khớp tên và địa chỉ trong cơ sở dữ liệu.');
                say('audio-status','noAudio','Chưa có audio của quán');
                return;
            }
            const shopResponse = await fetch(`/api/public/shops/${approvedShop.id}/content`);
            if (!shopResponse.ok) throw new Error('Quán chưa có nội dung được duyệt trong hệ thống.');
            const published = await shopResponse.json();
            if (published.name !== selected.name || !published.versionId)
                throw new Error('Nội dung xuất bản chưa khớp với quán đã chọn.');
            versionId = published.versionId;
            setStatus('approved','Nội dung đã được duyệt.');
            if (!$('language').value) {
                setStatus('languageMissing','Ngôn ngữ này chưa khả dụng. Vui lòng chọn ngôn ngữ khác.');
                return;
            }
            await loadNarration();
        } catch(e) {
            setStatus('translationError',e.message);
            say('audio-status','noAudio','Chưa có audio');
        }
    })();
})();
</script>
</body>
</html>
