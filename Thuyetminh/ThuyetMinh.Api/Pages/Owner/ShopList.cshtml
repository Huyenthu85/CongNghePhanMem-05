@page
@model CongNghePhanMem.Api.Pages.Owner.ShopListModel
@{
    ViewData["Title"] = "Quán của tôi";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h2 style="margin: 0; border: none;">Quán của tôi</h2>
    <a href="/Owner/ShopForm" class="btn btn-primary" style="margin: 0;">+ Thêm quán mới</a>
</div>

@if (Model.HasRejectedSubmissions)
{
    <div class="error" style="margin-bottom: 24px;">
        ⚠️ <strong>Cảnh báo:</strong> Bạn có bài gửi cho quán bị <strong>Từ chối</strong>. Vui lòng kiểm tra mục "Bài gửi" để xem lý do và gửi lại.
    </div>
}

@if (!Model.Shops.Any())
{
    <p>Bạn chưa có quán nào. Hãy bấm "Thêm quán mới" để bắt đầu.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Tên quán</th>
                <th>Địa chỉ</th>
                <th>Bán kính (m)</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Shops)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Address</td>
                <td>@s.ActivationRadiusMeters</td>
                <td>
                    @if (Model.LatestSubmissions.TryGetValue(s.Id, out var latest))
                    {
                        switch (latest.Status)
                        {
                            case ThuyetMinh.Data.Models.SubmissionStatus.Draft:
                                <span class="badge badge-draft">Nháp</span>
                                break;

                            case ThuyetMinh.Data.Models.SubmissionStatus.Pending:
                                <span class="badge badge-pending">Chờ duyệt</span>
                                break;

                            case ThuyetMinh.Data.Models.SubmissionStatus.Approved:
                                <span class="badge badge-approved">Đã duyệt</span>
                                if (Model.LatestSubmissions.TryGetValue(s.Id, out var currentSubmission)
                                    && (s.PublishedVersionId != currentSubmission.Id
                                        || s.PublishStatus != ThuyetMinh.Data.Models.PublishStatus.Approved))
                                {
                                    <div style="font-size:12px; margin-top:5px;">
                                        Chưa công bố phiên bản mới - audio chưa sẵn sàng.
                                    </div>
                                }
                                break;

                            case ThuyetMinh.Data.Models.SubmissionStatus.Rejected:
                                <span class="badge badge-rejected">Bị từ chối</span>
                                <div style="color:#ef4444; font-size:12px; margin-top:6px; overflow-wrap:anywhere;">
                                    Lý do: @latest.RejectionReason
                                </div>
                                break;
                        }

                        if (s.PublishedVersionId.HasValue &&
                            s.PublishStatus == ThuyetMinh.Data.Models.PublishStatus.Approved &&
                            latest.Status != ThuyetMinh.Data.Models.SubmissionStatus.Approved)
                        {
                            <div style="font-size:12px; margin-top:6px; color:var(--text-muted);">
                                Phiên bản cũ vẫn đang công bố
                            </div>
                        }
                    }
                    else
                    {
                        <span class="badge badge-draft">Nháp</span>
                    }
                </td>
                <td>
                    <a class="btn btn-primary" style="padding: 6px 12px; font-size: 13px;" href="/Owner/ShopForm?id=@s.Id">Chỉnh sửa</a>
                    <a class="btn btn-secondary" style="padding: 6px 12px; font-size: 13px;" href="/Owner/Submissions?id=@s.Id">Bài gửi</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}