@page
@model ThuyetMinh.Api.Pages.Owner.SubmissionsModel
@{
    ViewData["Title"] = "Bài gửi của tôi";
}

<h2>Bài gửi cho quán</h2>
<p style="color:var(--text-muted); font-size:14px;">Quán: <strong>@Model.ShopName</strong></p>

@if (!Model.Submissions.Any())
{
    <p>Chưa có bài gửi nào.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Ngày gửi</th>
                <th>Tên</th>
                <th>Trạng thái</th>
                <th>Lý do từ chối</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var s in Model.Submissions)
        {
            <tr>
                <td>@s.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>@s.Name</td>
                <td>
                    @switch (s.Status)
                    {
                        case ThuyetMinh.Data.Models.SubmissionStatus.Draft:
                            <span class="badge badge-draft">Nháp</span>
                            break;
                        case ThuyetMinh.Data.Models.SubmissionStatus.Pending:
                            <span class="badge badge-pending">Chờ duyệt</span>
                            break;
                        case ThuyetMinh.Data.Models.SubmissionStatus.Approved:
                            <span class="badge badge-approved">Đã duyệt</span>
                            break;
                        case ThuyetMinh.Data.Models.SubmissionStatus.Rejected:
                            <span class="badge badge-rejected">Bị từ chối</span>
                            break;
                    }
                </td>
                <td>@(s.RejectionReason ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
}

<a class="btn btn-secondary" href="/Owner/ShopList">Quay lại</a>